# Generated by e2e/fixtures/build from the fixtures' sender domains: edit the sources and run
# node e2e/fixtures/build/main.ts. The test stack's DNS server (docker/compose.e2e.yaml,
# service dns): CoreDNS answering for the fixtures' sender domains, so the sender check's MX
# lookups run for real without the internet (MVP 2, F5). The .example zone comes from /zones;
# a public domain's MX and mail host are answered by exact name, never as a whole zone. Every
# other name is forwarded to Docker's resolver, which also knows the stack's services.
. {
    auto {
        directory /zones
    }
    template IN MX {
        match "^gmail[.]com[.]$"
        match "^greenhouse-mail[.]io[.]$"
        match "^hire[.]lever[.]co[.]$"
        match "^indeed[.]com[.]$"
        match "^jobs[.]nhs[.]uk[.]$"
        match "^linkedin[.]com[.]$"
        match "^myworkday[.]com[.]$"
        match "^nationalevacaturebank[.]nl[.]$"
        match "^net-empregos[.]com[.]$"
        match "^personio[.]de[.]$"
        match "^recruitee[.]com[.]$"
        match "^smartrecruiters[.]com[.]$"
        match "^stepstone[.]de[.]$"
        match "^teamtailor[.]com[.]$"
        match "^totaljobs[.]com[.]$"
        match "^workablemail[.]com[.]$"
        match "^xing[.]com[.]$"
        answer "{{ .Name }} 300 IN MX 10 mx.{{ .Name }}"
        fallthrough
    }
    template IN A {
        match "^mx[.]gmail[.]com[.]$"
        match "^mx[.]greenhouse-mail[.]io[.]$"
        match "^mx[.]hire[.]lever[.]co[.]$"
        match "^mx[.]indeed[.]com[.]$"
        match "^mx[.]jobs[.]nhs[.]uk[.]$"
        match "^mx[.]linkedin[.]com[.]$"
        match "^mx[.]myworkday[.]com[.]$"
        match "^mx[.]nationalevacaturebank[.]nl[.]$"
        match "^mx[.]net-empregos[.]com[.]$"
        match "^mx[.]personio[.]de[.]$"
        match "^mx[.]recruitee[.]com[.]$"
        match "^mx[.]smartrecruiters[.]com[.]$"
        match "^mx[.]stepstone[.]de[.]$"
        match "^mx[.]teamtailor[.]com[.]$"
        match "^mx[.]totaljobs[.]com[.]$"
        match "^mx[.]workablemail[.]com[.]$"
        match "^mx[.]xing[.]com[.]$"
        answer "{{ .Name }} 300 IN A 192.0.2.25"
        fallthrough
    }
    forward . /etc/resolv.conf
    errors
    log
}
