# The test stack's DNS server (docker/compose.e2e.yaml, service dns): CoreDNS answering for the
# fixtures' sender domains from the zone files in zones/ (db.<zone>, written by the fixture
# generator), so the sender check's MX lookups run for real without the internet (MVP 2, F5).
# Every other name is forwarded to Docker's resolver, which also knows the stack's services.
. {
    auto {
        directory /zones
    }
    forward . /etc/resolv.conf
    errors
    log
}
