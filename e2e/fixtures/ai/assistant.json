  "i'd now also take a hybrid job in munich": {
    "*": {
      "reply": "I'll add Munich, hybrid, to the places you'd work.",
      "clarify": null,
      "proposal": {
        "summary": "Add Munich, hybrid to the places you'd work",
        "changes": [
          {
            "op": "add",
            "target": "entry",
            "key": "places",
            "value": [
