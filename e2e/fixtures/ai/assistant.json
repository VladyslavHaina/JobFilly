{
  "lately i don't want jobs in asian time zones anymore, ignore them": {
    "*": {
      "reply": "I can hide roles on Asian time zones for you. Here is a proposal.",
      "clarify": null,
      "proposal": {
        "summary": "Hide roles whose working hours are UTC+5 or later",
        "changes": [
          {
            "op": "add",
            "target": "rule",
            "rule": {
              "description": "Hide roles whose working hours are UTC+5 or later",
              "when": [
                {
                  "fact": "timeZones",
                  "op": "within",
                  "value": {
                    "from": "UTC+05:00",
                    "to": "UTC+14:00"
                  }
                }
              ],
              "then": "hide",
              "enabled": true
            }
          }
        ]
      }
    }
  },
  "ask me first before replying to anyone from hirewave.example": {
    "*": {
      "reply": "Sure. From now on I'll ask you before drafting a reply to hirewave.example.",
      "clarify": null,
      "proposal": {
        "summary": "Ask you before drafting a reply to mail from hirewave.example",
        "changes": [
          {
            "op": "add",
            "target": "rule",
            "rule": {
              "description": "Ask me before drafting a reply to mail from hirewave.example",
              "when": [
                {
                  "fact": "sender.domain",
                  "op": "in",
                  "value": [
                    "hirewave.example"
                  ]
                }
              ],
              "then": "ask_first",
              "enabled": true
            }
          }
        ]
      }
    }
  },
