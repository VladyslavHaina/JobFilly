  "raise my minimum salary to €75,000 a year": {
    "*": {
      "reply": "Here is the change: €75,000 a year, and your day rate stays as it is.",
      "clarify": null,
      "proposal": {
        "summary": "Raise your minimum pay to €75,000 a year; your day rate stays €450",
        "changes": [
          {
            "op": "update",
            "target": "entry",
            "key": "min_pay",
            "value": [
              {
                "amount": 75000,
                "currency": "EUR",
                "period": "year",
                "asWritten": "€75,000 a year"
              },
              {
                "amount": 450,
                "currency": "EUR",
                "period": "day",
                "asWritten": "€450 a day"
              }
            ]
          }
        ]
      }
    }
  },
