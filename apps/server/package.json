{
  "name": "@jobfilly/server",
  "version": "0.0.0",
  "private": true,
  "description": "HTTP API, sessions and background jobs. Serves the web UI in Docker and Kubernetes.",
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@hono/zod-validator": "^0.9.1",
    "@jobfilly/ai": "workspace:*",
    "@jobfilly/core": "workspace:*",
    "@jobfilly/db": "workspace:*",
    "@jobfilly/mail": "workspace:*",
    "@jobfilly/schema": "workspace:*",
    "hono": "^4.13.13",
    "mammoth": "^1.13.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "tsx": "^4.23.15"
  }
}
