{
  "name": "@jobfilly/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Electron shell: starts the server inside the app and opens a window on it.",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsup",
    "start": "electron .",
    "dev": "pnpm --filter @jobfilly/web build && tsup && electron .",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@jobfilly/server": "workspace:*"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "tsup": "^8.5.1"
  }
}
