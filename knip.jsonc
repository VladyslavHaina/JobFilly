{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // Workflow scripts are run by Claude Code, not imported by the app.
  "ignore": [".claude/**"],
  // ignoreDependencies: dependencies installed ahead of the code that first uses them. Remove an
  // entry in the change that starts importing it. At every MVP sign-off this list may only hold
  // dependencies a later MVP needs (nodemailer: MVP 2).
  "workspaces": {
    ".": {},
    "apps/server": {},
    "apps/web": {},
    "packages/ai": {
      "ignoreDependencies": ["@ai-sdk/anthropic", "@ai-sdk/google", "@ai-sdk/openai"]
    },
    "packages/core": {},
    "packages/db": {},
    "packages/mail": {
      "ignoreDependencies": [
        "imapflow",
        "mailparser",
        "nodemailer",
        "@types/mailparser",
        "@types/nodemailer"
      ]
    },
    // The test stack's entry points are started by stack.ts, compose and the e2e image, not
    // imported: the stack runner, the fake AI, the seed loader, the fixture generator, the
    // Playwright config and specs.
    "e2e": {
      "entry": [
        "stack.ts",
        "fake-ai/main.ts",
        "seed/main.ts",
        "fixtures/build/main.ts",
        "playwright.config.ts",
        "specs/**/*.spec.ts"
      ],
      "project": ["**/*.ts"],
      "ignoreDependencies": ["@playwright/test", "imapflow"]
    }
  }
}
