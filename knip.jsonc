{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // e2e/helm.test.ts runs helm when it is on PATH and skips otherwise; it isn't a dependency.
  "ignoreBinaries": ["helm"],
  "workspaces": {
    ".": {},
    "apps/server": {},
    "apps/web": {},
    "packages/ai": {},
    "packages/core": {},
    "packages/db": {},
    "packages/mail": {},
    // The test stack's entry points are started by stack.ts, compose and the e2e image, not
    // imported: the stack runner, the fake AI, the seed loader, the fake RDAP service (compose
    // runs `node e2e/rdap/main.ts`), the fixture generator, the Playwright config and specs.
    // CoreDNS runs from e2e/dns/Corefile, so the dns service has no entry point here. A change
    // that adds another entry point adds it here in the same change, so this list names only
    // files that exist.
    "e2e": {
      "entry": [
        "stack.ts",
        "fake-ai/main.ts",
        "seed/main.ts",
        "rdap/main.ts",
        "oauth/main.ts",
        "fixtures/build/main.ts",
        "scripts/rolling-restart.ts",
        "playwright.config.ts",
        "specs/**/*.spec.ts"
      ],
      "project": ["**/*.ts"]
    }
  }
}
