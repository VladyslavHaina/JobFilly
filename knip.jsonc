{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // Workflow scripts are run by Claude Code, not imported by the app.
  "ignore": [".claude/**"],
  // ignoreDependencies: dependencies installed ahead of the code that first uses them. Remove an
  // entry in the change that starts importing it. At every MVP sign-off this list may only hold
  // dependencies a later MVP needs. During MVP 2's build the slices never edit this file: the
  // integrator removes unpdf, mammoth (cvs-senders) and nodemailer (mailbox) when it merges the
  // slice that first imports each.
  "workspaces": {
    ".": {},
    "apps/server": {
      "ignoreDependencies": ["unpdf", "mammoth"]
    },
    "apps/web": {},
    "packages/ai": {},
    "packages/core": {},
    "packages/db": {},
    "packages/mail": {
      "ignoreDependencies": ["nodemailer", "@types/nodemailer"]
    },
    // The test stack's entry points are started by stack.ts, compose and the e2e image, not
    // imported: the stack runner, the fake AI, the seed loader, the fixture generator, the
    // Playwright config and specs, and from MVP 2 the fake RDAP service and the DNS fixture's
    // script (e2e-fixtures must use exactly these names; the integrator drops dns/main.ts if no
    // such script is added).
    "e2e": {
      "entry": [
        "stack.ts",
        "fake-ai/main.ts",
        "seed/main.ts",
        "fixtures/build/main.ts",
        "playwright.config.ts",
        "specs/**/*.spec.ts",
        "rdap/main.ts",
        "dns/main.ts"
      ],
      "project": ["**/*.ts"]
    }
  }
}
